 -sv "workspaceLayoutToLoadOnStartup" "General"
 -iv "workspaceLinkHotKeySetEnabled" 0
 -sv "workspaceLinkHotKeySetValue" "Maya_Default"
 -iv "workspaceLinkMenuSetEnabled" 0
 -iv "workspaceLinkVP2PresetEnabled" 0
 -iv "workspacesAutoSave" 1
 ;

// polyAppendFacetContext Tool
optionVar -cat "polyAppendFacetContext Tool"
 -iv "planarConstraint_polyAppendFacetContext" 0
 ;

// sculptMeshCacheContext Tool
optionVar -cat "sculptMeshCacheContext Tool"
 -fv "buildUpRate_sculptMeshCacheContext" 50
 -sv "image1_sculptMeshCacheContext" "Bulge"
 -sv "lastMode_sculptMeshCacheContext" "Clone"
 -fv "minSize_sculptMeshCacheContext" 25
 -sv "mode_sculptMeshCacheContext" "Bulge"
 -fv "size_sculptMeshCacheContext" 25
 -fv "stampRandomizePosX_sculptMeshCacheContext" 40
 -fv "stampRandomizePosY_sculptMeshCacheContext" 40
 -fv "stampRandomizeRotation_sculptMeshCacheContext" 35
 -fv "strength_sculptMeshCacheContext" 15
 -iv "updatePlane_sculptMeshCacheContext" 1
 -fv "wireframeAlpha_sculptMeshCacheContext" 0.25
 ;

// Uncategorized
optionVar
 -sv "LookdevX_GlobalLibrariesDefault" ""
 -sv "LookdevX_UserLibraryDefault" "C:/Users/B00976905/Autodesk/LookdevX/Compounds/user"
 -iv "arnold_viewportHUDColor" 18
 -iv "arnold_viewportShowHUD" 1
 -sv "mtoaBuildID" "7ea71e5c (HEAD)"
 -iv "oneTimeAutoLoadPluginFlow.py" 1
 -iv "oneTimeAutoLoadPluginbifrostGraph" 1
 -iv "oneTimeAutoLoadPluginflowRetopology.py" 1
 -iv "oneTimeAutoLoadPluginflowWedging" 1
 -iv "oneTimeAutoLoadPluginmayaVnnPlugin" 1
 ;

nurbsToPolygonsPref -f 3 -cht 0.2 -pc 1000 -pt 1;
freezeOptions -dn none -up none -rn 0 -rt 0 -ep 0 -inv 0 -dl 0;

makePaintable -ca;
makePaintable -at "multiFloat" -sm "deformer" "bulgeMesh" "weights";
makePaintable -at "multiFloat" -sm "deformer" "cMuscleMultiCollide" "weights";
